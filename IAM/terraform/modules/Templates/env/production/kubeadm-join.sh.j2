#!/bin/bash
set -euo pipefail

# Fetch join params
JOIN_TOKEN=$(aws ssm get-parameter --name "/kubernetes/{{ DEPARTMENT }}/join_token" --with-decryption --query "Parameter.Value" --output text --region {{ REGION }})
JOIN_SHA256=$(aws ssm get-parameter --name "/kubernetes/{ DEPARTMENT }}/join_sha256" --with-decryption --query "Parameter.Value" --output text --region {{ REGION }})
API_SERVER="https://k8s.{{ DOMAIN_NAME }}:6443"

# Check if already joined (kubelet running with kubeconfig)
if systemctl is-active --quiet kubelet && [ -f /etc/kubernetes/kubelet.conf ]; then
  echo "[$(date)] Node already joined, skipping"
  exit 0
fi

# Run join
echo "[$(date)] Running kubeadm join..."
kubeadm join "$API_SERVER" \
  --token "$JOIN_TOKEN" \
  --discovery-token-ca-cert-hash sha256:"$JOIN_SHA256"