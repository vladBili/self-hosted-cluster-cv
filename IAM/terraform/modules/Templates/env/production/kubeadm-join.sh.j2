#!/bin/bash
set -euo pipefail

# Fetch join params
JOIN_TOKEN=$(sudo aws ssm get-parameter --name "/kubernetes/{{ DEPARTMENT }}/join_token" --with-decryption --query "Parameter.Value" --output text --region {{ REGION }})
JOIN_SHA256=$(sudo aws ssm get-parameter --name "/kubernetes/{{ DEPARTMENT }}/join_sha256" --with-decryption --query "Parameter.Value" --output text --region {{ REGION }})
API_SERVER="k8s.{{ DOMAIN_NAME }}:6443"

# Check if already joined (kubelet running with kubeconfig)
if systemctl is-active --quiet kubelet && [ -f /etc/kubernetes/kubelet.conf ]; then
  echo "[$(date)] Node already joined, skipping"
  exit 0
fi

# Template join configuration
sudo cat > /tmp/kubeadm-join.yaml <<EOF
apiVersion: kubeadm.k8s.io/v1beta4
kind: JoinConfiguration
discovery:
  bootstrapToken:
    apiServerEndpoint: "$API_SERVER"
    token: "$JOIN_TOKEN"
    caCertHashes:
      - "sha256:$JOIN_SHA256"
nodeRegistration:
  kubeletExtraArgs:
    - name: cloud-provider 
      value: external
    - name: image-credential-provider-bin-dir
      value: /usr/local/bin
    - name: image-credential-provider-config
      value: /etc/kubernetes/credential-provider-config.yaml
EOF

# Run join
echo "[$(date)] Running kubeadm join..."
sudo kubeadm join --config /tmp/kubeadm-join.yaml