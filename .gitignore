# Ignore Terraform-specific files
*.tfstate
*.tfstate.*
*.backup
.terraform/
plan/
.terraform.lock.hcl
*.DS_Store
*.vscode
*.tfvars
__pycache__
.pyc

*.env

# Ansible facts (dynamic hostnames)
IAM/ansible/env/**/facts/
IAM/ansible/env/**/inventory/

# Ansible keys (private material)
IAM/ansible/env/**/keys/

# Kubernetes generated env files
IAM/kubernetes/env/

# OpenVPN generated configs
IAM/openvpn/**/configuration/
IAM/openvpn/**/templates/

# HaProxy generated configs
IAM/haproxy/**/templates/

# Terraform environment configs/state
IAM/terraform/env/**/config/
